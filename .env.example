# Local configuration. This file contains no working secret.
# Generate DJANGO_SECRET_KEY as described in README.md; never commit .env.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Production reads environment variables directly, without loading .env.
# Set DJANGO_SETTINGS_MODULE=config.settings.production in the deployment.

# Required before login/password forms can be used after E9.
# Site key is public; secret key is server-only. Hostnames have no scheme/port.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
